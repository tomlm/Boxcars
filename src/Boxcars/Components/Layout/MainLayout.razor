@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject PlayerProfileService ProfileService
@using Boxcars.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<MudThemeProvider Theme="_darkTheme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* A full-height flex column. The game page has no app bar (its profile menu sits beside the board's tabs), so it
   fills the window; other pages scroll under the app bar. *@
<MudLayout Class="d-flex flex-column">
    @if (!IsGameRoute)
    {
        <MudAppBar Elevation="1" Style="overflow: visible">
            <MudLink Href="/" Underline="Underline.None" Color="MudBlazor.Color.Inherit">
                <MudText Typo="Typo.h5">BoxCars</MudText>
            </MudLink>
            <MudSpacer />
            <UserMenu />
        </MudAppBar>
    }
    <MudMainContent Class="@MainContentClass">
        @if (IsGameRoute)
        {
            <div class="d-flex flex-column flex-grow-1 overflow-hidden">
                @Body
            </div>
        }
        else
        {
            <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
                @Body
            </MudContainer>
        }
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private static readonly MudTheme _darkTheme = new()
    {
        PaletteDark = new PaletteDark()
    };

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool IsAccountRoute => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("preferences", StringComparison.OrdinalIgnoreCase)
        || Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("login", StringComparison.OrdinalIgnoreCase);

    private bool IsGameRoute => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("game/", StringComparison.OrdinalIgnoreCase);

    // MudMainContent leaves room for an app bar; the game page has none.
    private string MainContentClass => IsGameRoute
        ? "d-flex flex-column overflow-hidden pt-0"
        : "d-flex flex-column overflow-auto";

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationStateTask is null || IsAccountRoute)
        {
            return;
        }

        var authenticationState = await AuthenticationStateTask;
        if (authenticationState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var userId = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        var profile = await ProfileService.GetProfileAsync(userId, CancellationToken.None);
        if (profile is not null && PlayerProfileService.HasRequiredStrategyText(profile.StrategyText))
        {
            return;
        }

        var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relativeUri)
            ? "/dashboard"
            : string.Concat("/", relativeUri);
        var redirectUri = Navigation.GetUriWithQueryParameters("/preferences", new Dictionary<string, object?>
        {
            ["requiredStrategy"] = true,
            ["returnUrl"] = returnUrl
        });

        Navigation.NavigateTo(redirectUri, replace: true);
    }
}