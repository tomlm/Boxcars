@using Boxcars.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject PlayerProfileService ProfileService

<AuthorizeView>
    <Authorized>
        <MudTooltip Text="Report a bug">
            <MudIconButton Icon="@Icons.Material.Filled.BugReport"
                           Color="MudBlazor.Color.Inherit"
                           aria-label="Report a bug"
                           OnClick="OpenAsync" />
        </MudTooltip>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private async Task OpenAsync()
    {
        var pagePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        // On a game page the report carries that game's state.
        var gameId = pagePath.StartsWith("game/", StringComparison.OrdinalIgnoreCase)
            ? pagePath["game/".Length..].Split('/', '?', '#')[0]
            : null;

        var parameters = new DialogParameters<BugReportDialog>
        {
            { dialog => dialog.GameId, gameId },
            { dialog => dialog.PagePath, pagePath },
            { dialog => dialog.ReporterName, await ResolveReporterNameAsync() }
        };

        await DialogService.ShowAsync<BugReportDialog>("Report a bug", parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false
        });
    }

    // The player's nickname, never their email address: the issue is public.
    private async Task<string> ResolveReporterNameAsync()
    {
        if (AuthState is null)
        {
            return "Player";
        }

        var state = await AuthState;
        var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var profile = string.IsNullOrWhiteSpace(userId) ? null : await ProfileService.GetProfileAsync(userId, CancellationToken.None);
        return string.IsNullOrWhiteSpace(profile?.Nickname) ? "Player" : profile.Nickname;
    }
}
