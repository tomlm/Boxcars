@using Boxcars.Auth
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

@* Picks a profile image: shows the current or pending picture, lets the user upload one (resized right away) or remove it,
   and optionally edit it as a URL. The page uploads PendingImage when it saves. *@
<MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
    <MudAvatar Size="Size.Large">
        @if (string.IsNullOrWhiteSpace(PreviewSrc))
        {
            <MudIcon Icon="@Icons.Material.Filled.Person" />
        }
        else
        {
            <MudImage Src="@PreviewSrc" Alt="Picture" />
        }
    </MudAvatar>
    <MudStack Spacing="1" Class="flex-grow-1">
        @if (ShowUrlField)
        {
            <MudTextField T="string"
                          Value="@ImageUrl"
                          ValueChanged="OnUrlChangedAsync"
                          Label="Picture URL"
                          Variant="Variant.Outlined"
                          Placeholder="https://example.com/avatar.png"
                          Disabled="@Disabled" />
        }
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudFileUpload T="IBrowserFile" Accept="@ProfileImageResizer.AcceptedContentTypes" FilesChanged="OnFileSelectedAsync">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Primary"
                               StartIcon="@Icons.Material.Filled.Upload" Disabled="@(Disabled || _reading)">
                        Upload Image
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            @if (!string.IsNullOrWhiteSpace(PreviewSrc))
            {
                <MudButton Variant="Variant.Text" Color="MudBlazor.Color.Secondary" OnClick="RemoveAsync" Disabled="@Disabled">
                    Remove
                </MudButton>
            }
        </MudStack>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Error">@_error</MudText>
        }
        else
        {
            <MudText Typo="Typo.caption" Style="opacity: 0.75">
                @(PendingImage is null ? "PNG, JPEG, GIF or WebP, up to 10 MB." : "New image will be saved when you save changes.")
            </MudText>
        }
    </MudStack>
</MudStack>

@code {
    private const long MaxImageBytes = 10 * 1024 * 1024;

    private string? _error;
    private bool _reading;

    /// <summary>The saved picture URL.</summary>
    [Parameter]
    public string? ImageUrl { get; set; }

    [Parameter]
    public EventCallback<string?> ImageUrlChanged { get; set; }

    /// <summary>A resized image picked but not yet uploaded; it replaces <see cref="ImageUrl"/> when the page saves.</summary>
    [Parameter]
    public byte[]? PendingImage { get; set; }

    [Parameter]
    public EventCallback<byte[]?> PendingImageChanged { get; set; }

    [Parameter]
    public bool ShowUrlField { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private string? PreviewSrc => PendingImage is null
        ? ImageUrl
        : $"data:{ProfileImageResizer.ContentType};base64,{Convert.ToBase64String(PendingImage)}";

    private async Task OnFileSelectedAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        _error = null;
        if (!ProfileImageResizer.IsAcceptedContentType(file.ContentType))
        {
            _error = "Choose a PNG, JPEG, GIF or WebP image.";
            return;
        }

        if (file.Size > MaxImageBytes)
        {
            _error = "Image must be 10 MB or smaller.";
            return;
        }

        _reading = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxImageBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;
            var resized = ProfileImageResizer.Resize(buffer);
            if (resized is null)
            {
                _error = "Unable to read that image.";
                return;
            }

            await PendingImageChanged.InvokeAsync(resized);
        }
        catch (IOException)
        {
            _error = "Unable to read that image.";
        }
        finally
        {
            _reading = false;
        }
    }

    private async Task OnUrlChangedAsync(string? url)
    {
        _error = null;
        await PendingImageChanged.InvokeAsync(null);
        await ImageUrlChanged.InvokeAsync(url);
    }

    private async Task RemoveAsync()
    {
        _error = null;
        await PendingImageChanged.InvokeAsync(null);
        await ImageUrlChanged.InvokeAsync(string.Empty);
    }
}
