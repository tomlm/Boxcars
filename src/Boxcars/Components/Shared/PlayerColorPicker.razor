@using Boxcars.Data
@using MudBlazor

@* A chip per player color, each shown in its color. *@
<MudChipSet T="string" SelectedValue="@Value" SelectedValueChanged="@ValueChanged"
            SelectionMode="SelectionMode.SingleSelection"
            CheckMark>
    @foreach (var color in PlayerColorOptions.Colors)
    {
        <MudChip T="string" Value="@color" Style="@GetColorChipStyle(color)">
            @PlayerColorOptions.ToLabel(color)
        </MudChip>
    }
</MudChipSet>

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    private static string GetColorChipStyle(string color)
    {
        var (bg, fg) = PlayerColorOptions.NormalizeOrDefault(color) switch
        {
            "darkblue" => ("#0b3d91", "#f8fbff"),
            "blue" => ("#2563eb", "#f8fbff"),
            "cyan" => ("#06b6d4", "#f8fbff"),
            "red" => ("#dc2626", "#fff7f7"),
            "darkred" => ("#7f1d1d", "#fff7f7"),
            "orange" => ("#ea580c", "#fff7ed"),
            "yellow" => ("#facc15", "#1f2937"),
            "purple" => ("#9333ea", "#faf5ff"),
            "green" => ("#16a34a", "#f7fff9"),
            "darkgreen" => ("#166534", "#f7fff9"),
            "white" => ("#f8fafc", "#1f2937"),
            "lavender" => ("#c4b5fd", "#1f2937"),
            "black" => ("#111827", "#f9fafb"),
            "hotpink" => ("#ff1493", "#fff0f7"),
            _ => ("#4b5563", "#fff")
        };
        return $"background: {bg}; color: {fg}; font-weight: 700; text-shadow: 0 1px 2px rgb(0 0 0 / 0.75), 0 0 10px rgb(0 0 0 / 0.35)";
    }
}
