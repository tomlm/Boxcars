@using Boxcars.Services
@using MudBlazor

@* Debug mode: a bot move that pays opponents waits here for the game's admin. *@
<MudPaper Outlined="true" Elevation="4" Class="pa-2 rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.BugReport" Color="MudBlazor.Color.Warning" />
        <MudStack Spacing="0">
            <MudText Typo="Typo.subtitle2">@Review.PlayerName's move pays opponents</MudText>
            @foreach (var fee in Review.Fees)
            {
                <MudText Typo="Typo.body2">@FormatCurrency(fee.Amount) to @fee.OwnerName for @string.Join(", ", fee.RailroadNames)</MudText>
            }
            <MudText Typo="Typo.caption">Approve the bot's route, or change it on the map and press MOVE.</MudText>
        </MudStack>
        <MudButton Variant="Variant.Filled"
                   Color="MudBlazor.Color.Warning"
                   Disabled="@IsBusy"
                   OnClick="ApproveRequested">
            Approve
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public BotRouteReview Review { get; set; } = default!;

    [Parameter]
    public EventCallback ApproveRequested { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    private static string FormatCurrency(int value)
    {
        return $"${Math.Max(0, value):N0}";
    }
}
