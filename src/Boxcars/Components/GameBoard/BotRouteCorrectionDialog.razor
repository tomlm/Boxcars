@using MudBlazor

@* Debug mode: asks the admin why they moved a bot along a different route, for the bug report. *@
<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.BugReport" Color="MudBlazor.Color.Warning" />
            <MudText Typo="Typo.h6">Why a different route?</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudStack Spacing="1">
                <MudText Typo="Typo.subtitle2">@BotName's route</MudText>
                <MudText Typo="Typo.body2">@BotRoute</MudText>
            </MudStack>
            <MudStack Spacing="1">
                <MudText Typo="Typo.subtitle2">Your route</MudText>
                <MudText Typo="Typo.body2">@ChosenRoute</MudText>
            </MudStack>
            <MudTextField T="string"
                          @bind-Value="_reason"
                          Label="Why is your route better?"
                          Lines="3"
                          AutoGrow="true"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudText Typo="Typo.caption">
                @(CanFileReport
                    ? "Both routes, your reason and the game state (without email addresses) are filed as an issue in the public Boxcars GitHub repository."
                    : "Bug reporting isn't set up on this server (no GitHub token), so the bot will just move along your route.")
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="MudBlazor.Color.Default" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@string.IsNullOrWhiteSpace(_reason)"
                   OnClick="Submit">
            @(CanFileReport ? "Move and file bug" : "Move")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string BotName { get; set; } = "Bot";

    [Parameter]
    public string BotRoute { get; set; } = string.Empty;

    [Parameter]
    public string ChosenRoute { get; set; } = string.Empty;

    [Parameter]
    public bool CanFileReport { get; set; }

    private string _reason = string.Empty;

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Submit()
    {
        if (!string.IsNullOrWhiteSpace(_reason))
        {
            MudDialog.Close(DialogResult.Ok(_reason.Trim()));
        }
    }
}
