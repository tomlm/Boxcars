@using Boxcars.Data
@using System.Globalization
@using MudBlazor

<MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mx-auto">
    <MudPaper Outlined="true" Elevation="4" Class="d-flex align-center flex-wrap gap-4 pa-2 rounded-lg">
        <MudStack Spacing="0">
            <MudText Typo="Typo.subtitle1"><strong>Declare?</strong></MudText>
            <MudText Typo="Typo.body2">
                @PlayerName has @FormatCurrency(Cash) and is @DistanceText from @SlangNames.Apply(HomeCityName, SlangMode).
            </MudText>
        </MudStack>
        <MudButton Variant="Variant.Outlined"
                   Color="MudBlazor.Color.Default"
                   Disabled="@IsBusy"
                   OnClick="KeepPlayingRequested">
            Keep Playing
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   Disabled="@IsBusy"
                   OnClick="DeclareRequested">
            Declare
        </MudButton>
    </MudPaper>
</MudStack>

@code {
    [CascadingParameter(Name = SlangNames.CascadingValueName)]
    public bool SlangMode { get; set; }
    [Parameter, EditorRequired]
    public string PlayerName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string HomeCityName { get; set; } = string.Empty;

    [Parameter]
    public int Cash { get; set; }

    /// <summary>Dots from home, or null when it can't be worked out.</summary>
    [Parameter]
    public int? DistanceToHome { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    /// <summary>Declare and head home instead of drawing a destination.</summary>
    [Parameter]
    public EventCallback DeclareRequested { get; set; }

    /// <summary>Draw a destination as usual.</summary>
    [Parameter]
    public EventCallback KeepPlayingRequested { get; set; }

    private string DistanceText => DistanceToHome is int distance
        ? string.Create(CultureInfo.InvariantCulture, $"{distance} {(distance == 1 ? "dot" : "dots")}")
        : "an unknown distance";

    private static string FormatCurrency(int value)
    {
        return $"${value:N0}";
    }
}
