@using Boxcars.Data
@using MudBlazor

@if (Summary.HasContent)
{
    <MudPaper Outlined="true" Class="pa-3 mx-1 mb-1" Style="background: color-mix(in srgb, var(--mud-palette-surface) 92%, black 8%)">
        <MudStack Spacing="2">
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle2">Display</MudText>
                <MudSwitch T="bool" Value="SlangMode" ValueChanged="SlangModeChanged" Color="Color.Primary"
                           Label="Slang mode" />
                <MudText Typo="Typo.caption">Nicknames for some cities, railroads and the Superchief, on your screen only.</MudText>
            </MudStack>

            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle2">Sound</MudText>
                <MudSwitch T="bool" Value="GameAudio" ValueChanged="GameAudioChanged" Color="Color.Primary"
                           Label="Game sounds" />
                <MudText Typo="Typo.caption">Boxcars, purchases, fees you collect, declarations, rovers and the winner.</MudText>
                <MudSwitch T="bool" Value="TurnAudio" ValueChanged="TurnAudioChanged" Color="Color.Primary"
                           Label="Your turn sound" />
                <MudText Typo="Typo.caption">Plays when it's your turn. Pick the sound in Preferences.</MudText>
            </MudStack>

            <MudDivider />

            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@Summary.Title</MudText>
                @if (!string.IsNullOrWhiteSpace(Summary.SourceDescription))
                {
                    <MudText Typo="Typo.caption">@Summary.SourceDescription</MudText>
                }
            </MudStack>

            @if (Summary.Warnings.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                    @foreach (var warning in Summary.Warnings)
                    {
                        <MudText Typo="Typo.caption">@warning</MudText>
                    }
                </MudAlert>
            }

            @for (var index = 0; index < Summary.Sections.Count; index++)
            {
                var settingsSection = Summary.Sections[index];

                if (index > 0)
                {
                    <MudDivider />
                }

                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">@settingsSection.Title</MudText>

                    @foreach (var item in settingsSection.Items)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="1">
                            <MudText Typo="Typo.body2">@SlangNames.Apply(item.Label, SlangMode)</MudText>
                            <MudText Typo="Typo.body2" Align="Align.Right" Class="text-end">@SlangNames.Apply(item.Value, SlangMode)</MudText>
                        </MudStack>
                    }
                </MudStack>
            }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter]
    public GameSettingsSummaryModel Summary { get; set; } = GameSettingsSummaryModel.Empty;

    /// <summary>This player's slang mode, which they can turn on or off at any time.</summary>
    [Parameter]
    public bool SlangMode { get; set; }

    [Parameter]
    public EventCallback<bool> SlangModeChanged { get; set; }

    /// <summary>Whether this player hears the game's event sounds.</summary>
    [Parameter]
    public bool GameAudio { get; set; }

    [Parameter]
    public EventCallback<bool> GameAudioChanged { get; set; }

    /// <summary>Whether this player hears their "your turn" sound.</summary>
    [Parameter]
    public bool TurnAudio { get; set; }

    [Parameter]
    public EventCallback<bool> TurnAudioChanged { get; set; }
}