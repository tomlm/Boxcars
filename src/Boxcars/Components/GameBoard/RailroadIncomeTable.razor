@using Boxcars.Data
@using Boxcars.Services
@using MudBlazor

@if (Income.Rows.Count == 0)
{
    <MudAlert Severity="Severity.Info" Dense="true">Railroad income is not available yet.</MudAlert>
}
else
{
    <MudPaper Outlined="true" Class="pa-3 d-flex flex-column overflow-auto align-self-start" Style="width: fit-content; max-width: 100%">
        <MudText Typo="Typo.caption" Class="mb-2">
            Fees opponents have paid to ride each railroad this game, grouped by its current owner.
        </MudText>
        <div class="railroad-income-table">
            <MudSimpleTable Dense="true" Hover="true" FixedHeader="true">
                <thead>
                    <tr>
                        <th>Railroad</th>
                        <th style="text-align: right">Fees Collected</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in Groups)
                    {
                        <tr>
                            <td><strong>@group.OwnerName</strong></td>
                            <td style="text-align: right"><strong>@FormatCurrency(group.Rows.Sum(row => row.FeesCollected))</strong></td>
                        </tr>
                        @foreach (var row in group.Rows)
                        {
                            <tr>
                                <td style="padding-left: 2rem">@row.RailroadName</td>
                                <td style="text-align: right">@FormatCurrency(row.FeesCollected)</td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public RailroadIncome Income { get; set; } = RailroadIncome.Empty;

    [Parameter]
    public IReadOnlyList<PlayerBoardModel> Players { get; set; } = [];

    // Rows arrive ordered by owner, with the bank's railroads last.
    private IEnumerable<(string OwnerName, List<RailroadIncomeRow> Rows)> Groups => Income.Rows
        .GroupBy(row => row.OwnerIndex)
        .Select(group => (ResolveOwnerName(group.Key), group.ToList()));

    private string ResolveOwnerName(int? ownerIndex)
    {
        if (ownerIndex is not int index)
        {
            return "Unowned";
        }

        var name = Players.FirstOrDefault(player => player.Index == index)?.Name;
        return string.IsNullOrWhiteSpace(name) ? $"Seat {index + 1}" : name;
    }

    private static string FormatCurrency(int value)
    {
        return $"${value:N0}";
    }
}
