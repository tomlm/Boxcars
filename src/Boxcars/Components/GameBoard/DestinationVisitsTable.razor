@using Boxcars.Data
@using System.Globalization
@using Boxcars.Services
@using MudBlazor

@if (Visits.TotalDraws == 0)
{
    <MudAlert Severity="Severity.Info" Dense="true">No destinations have been drawn yet.</MudAlert>
}
else
{
    <MudPaper Outlined="true" Class="pa-3 d-flex flex-column flex-grow-1 overflow-hidden align-self-start">
        <MudText Typo="Typo.caption" Class="mb-2">
            Expected is each city's chance on any one draw. Actual is its share of the @Visits.TotalDraws.ToString("N0", CultureInfo.InvariantCulture) destinations drawn this game.
        </MudText>
        <MudTable T="DestinationVisitRow" Items="Visits.Rows" FixedHeader="true" Height="100%" Class="flex-grow-1 overflow-hidden" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="DestinationVisitRow" SortBy="@(row => row.CityName)"><strong>City</strong></MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="DestinationVisitRow" SortBy="@(row => row.ExpectedPercentage)"><strong>Expected</strong></MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="DestinationVisitRow" SortBy="@(row => row.ActualPercentage)"><strong>Actual</strong></MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@SlangNames.Apply(context.CityName, SlangMode)</MudTd>
                <MudTd>@FormatPercent(context.ExpectedPercentage)</MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2" Color="@GetActualColor(context)">
                        @FormatPercent(context.ActualPercentage) (@context.DrawCount.ToString(CultureInfo.InvariantCulture))
                    </MudText>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    [CascadingParameter(Name = SlangNames.CascadingValueName)]
    public bool SlangMode { get; set; }
    [Parameter]
    public DestinationVisits Visits { get; set; } = DestinationVisits.Empty;

    // Green when the city has come up more often than its odds say, red when less.
    private static Color GetActualColor(DestinationVisitRow row)
    {
        return row.ActualPercentage > row.ExpectedPercentage
            ? Color.Success
            : row.ActualPercentage < row.ExpectedPercentage
                ? Color.Error
                : Color.Default;
    }

    private static string FormatPercent(double value)
    {
        return string.Create(CultureInfo.InvariantCulture, $"{value:0.0}%");
    }
}
