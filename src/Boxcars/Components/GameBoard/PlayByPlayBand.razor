@using Boxcars.Data
@using MudBlazor
@inject IJSRuntime JavaScriptRuntime
@implements IDisposable

@* Scrolls sideways by touch, scrollbar or mouse wheel. *@
<div @ref="_band"
     class="play-by-play-band d-flex align-center overflow-x-auto overflow-y-hidden autohide-scrollbar px-3 py-1 cursor-pointer"
     title="Open history"
     @onclick="OnBandClicked">
    @foreach (var entry in _visible)
    {
        <div @key="entry.Id" class="@(entry.Leaving ? "play-by-play-item play-by-play-leave" : "play-by-play-item play-by-play-enter")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="@BuildAccentStyle(entry.Message.AccentColorHex)">
                <MudIcon Icon="@entry.Message.Icon" Color="@entry.Message.IconColor" Size="Size.Small" />
                <MudText Typo="Typo.body2">@SlangNames.Apply(entry.Message.Text, SlangMode)</MudText>
            </MudStack>
        </div>
    }
</div>

@code {
    [CascadingParameter(Name = SlangNames.CascadingValueName)]
    public bool SlangMode { get; set; }
    private const int StepMs = 600;

    private readonly List<BandEntry> _visible = new();
    private readonly Queue<PlayByPlayMessage> _pending = new();
    private readonly CancellationTokenSource _disposeCancellation = new();
    private ElementReference _band;
    private int _nextEntryId;
    private bool _running;

    /// <summary>The game turn being played.</summary>
    [Parameter]
    public int CurrentTurnNumber { get; set; }

    /// <summary>Players still in the game, so how many turns make a round.</summary>
    [Parameter]
    public int PlayerCount { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>
    /// The oldest turn the band shows: the last two rounds, so the current turn and the turns since the current
    /// player's previous one. When a player's turn starts, their messages from two turns ago drop off.
    /// </summary>
    private int OldestTurnShown => CurrentTurnNumber - (2 * Math.Max(1, PlayerCount)) + 1;

    public void Enqueue(PlayByPlayMessage message)
    {
        _pending.Enqueue(message);
        if (!_running)
        {
            _ = RunAsync();
        }
    }

    /// <summary>
    /// Replaces the band with the last two rounds of <paramref name="messages"/> (oldest first), without animating
    /// them in. Used when the timeline is rewound, so the band no longer shows events that were undone.
    /// </summary>
    public void Reset(IReadOnlyList<PlayByPlayMessage> messages)
    {
        _pending.Clear();
        _visible.Clear();
        // Newest on the left.
        foreach (var message in messages.Where(message => message.TurnNumber >= OldestTurnShown).Reverse())
        {
            _visible.Add(new BandEntry(_nextEntryId++, message));
        }

        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        // A new turn: messages now more than two rounds old fade out.
        if (!_running && MarkOldEntriesLeaving())
        {
            _ = RemoveLeavingAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JavaScriptRuntime.InvokeVoidAsync("horizontalScroll.attach", _band);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private bool MarkOldEntriesLeaving()
    {
        var any = false;
        foreach (var entry in _visible.Where(entry => !entry.Leaving && entry.Message.TurnNumber < OldestTurnShown))
        {
            entry.Leaving = true;
            any = true;
        }

        return any;
    }

    private async Task RemoveLeavingAsync()
    {
        try
        {
            await Task.Delay(StepMs, _disposeCancellation.Token);
            _visible.RemoveAll(entry => entry.Leaving);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RunAsync()
    {
        _running = true;
        try
        {
            // One message per step so a burst of events still reads as individual arrivals. The newest goes on the
            // left and pushes the rest right, so on a narrow screen the latest stays in view. Messages more than two
            // rounds old fade out as they go.
            while (_pending.TryDequeue(out var message))
            {
                MarkOldEntriesLeaving();
                if (message.TurnNumber >= OldestTurnShown)
                {
                    _visible.Insert(0, new BandEntry(_nextEntryId++, message));
                }

                StateHasChanged();

                await Task.Delay(StepMs, _disposeCancellation.Token);
                _visible.RemoveAll(entry => entry.Leaving);
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _running = false;
        }
    }

    private Task OnBandClicked()
    {
        return OnClick.InvokeAsync();
    }

    private static string BuildAccentStyle(string? colorHex)
    {
        return string.IsNullOrWhiteSpace(colorHex)
            ? "border: 1px solid var(--mud-palette-divider); border-radius: 0.85rem; padding: 0.15rem 0.75rem; background: var(--mud-palette-surface)"
            : $"border-radius: 0.85rem; padding: 0.15rem 0.75rem; border: 1px solid color-mix(in srgb, {colorHex} 78%, black 22%); background: color-mix(in srgb, {colorHex} 72%, rgb(15 18 24) 28%); color: #fff";
    }

    public void Dispose()
    {
        _disposeCancellation.Cancel();
        _disposeCancellation.Dispose();
    }

    private sealed class BandEntry(int id, PlayByPlayMessage message)
    {
        public int Id { get; } = id;
        public PlayByPlayMessage Message { get; } = message;
        public bool Leaving { get; set; }
    }
}
