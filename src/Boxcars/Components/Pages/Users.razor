@page "/users"
@page "/bots"
@rendermode InteractiveServer
@using Azure
@using Boxcars.Auth
@using Boxcars.Components.Shared
@using Boxcars.Data
@using Boxcars.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@attribute [Authorize(Policy = AdminAccess.PolicyName)]
@inject NavigationManager Navigation
@inject UserAccountService UserAccounts
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Users - BoxCars</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="4">
        <MudStack Spacing="1">
            <MudText Typo="Typo.h3">Users</MudText>
            <MudText Typo="Typo.body1">
                Every account, people and bots. A strategy is what the AI follows when it plays the account: always for a bot, and for a person while their seat is on AI.
            </MudText>
        </MudStack>
        <MudButton Variant="Variant.Outlined"
                   Color="MudBlazor.Color.Primary"
                   OnClick='@(() => Navigation.NavigateTo("/dashboard"))'>
            Back to Dashboard
        </MudButton>
    </MudStack>

    <MudPaper Class="pa-6">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">@(_editing is null ? "Add User" : $"Edit {UserAccountService.DisplayName(_editing)}")</MudText>
            @if (_editing is not null)
            {
                <MudText Typo="Typo.body2">@_editing.RowKey · @UserAccountService.GetAccountType(_editing)</MudText>
            }
            else
            {
                <MudToggleGroup T="AccountType" @bind-Value="_editorAccountType" Color="MudBlazor.Color.Primary" Size="Size.Small">
                    <MudToggleItem Value="AccountType.Auth" Text="Auth" />
                    <MudToggleItem Value="AccountType.Email" Text="Email" />
                    <MudToggleItem Value="AccountType.Bot" Text="Bot" />
                </MudToggleGroup>
                @if (_editorAccountType != AccountType.Bot)
                {
                    <MudTextField @bind-Value="_editorEmail"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Required="true"
                                  HelperText="@(_editorAccountType == AccountType.Email ? "They pick their name on the email sign-in page." : "They sign in with Google or Microsoft as this email.")" />
                }
            }
            <ProfileEditor @key="_editorKey"
                           Account="_editing"
                           NewAccountType="_editorAccountType"
                           NewEmail="@_editorEmail"
                           ShowPictureUrl="true"
                           SaveText="@(_editing is null ? (_editorAccountType == AccountType.Bot ? "Add Bot" : "Add User") : "Save Changes")"
                           OnSaved="OnSavedAsync">
                @if (_editing is not null)
                {
                    <MudButton Variant="Variant.Text" OnClick="ResetEditor">Cancel</MudButton>
                }
            </ProfileEditor>
        </MudStack>
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="MudBlazor.Color.Primary" />
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
    }
    else
    {
        <MudTable T="ApplicationUser" Items="_accounts" Dense="true" Hover="true" FixedHeader="true" Height="60vh">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Color</MudTh>
                <MudTh>Strategy</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudAvatar Size="Size.Small">
                            @if (!string.IsNullOrWhiteSpace(context.ThumbnailUrl))
                            {
                                <MudImage Src="@context.ThumbnailUrl" Alt="@UserAccountService.DisplayName(context)" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                            }
                        </MudAvatar>
                        <MudText Typo="Typo.body2">@UserAccountService.DisplayName(context)</MudText>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Email">@(context.IsBot ? string.Empty : context.RowKey)</MudTd>
                <MudTd DataLabel="Type">@UserAccountService.GetAccountType(context)</MudTd>
                <MudTd DataLabel="Color">@(PlayerColorOptions.IsSupported(context.PreferredColor) ? PlayerColorOptions.ToLabel(context.PreferredColor) : string.Empty)</MudTd>
                <MudTd DataLabel="Strategy">@BuildStrategyPreview(context)</MudTd>
                <MudTd>
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="MudBlazor.Color.Primary"
                                       OnClick="() => BeginEdit(context)"
                                       aria-label="Edit account" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="MudBlazor.Color.Error"
                                       OnClick="() => DeleteAsync(context)"
                                       aria-label="Delete account" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudStack>

@code {
    private IReadOnlyList<ApplicationUser> _accounts = [];
    private ApplicationUser? _editing;
    private AccountType _editorAccountType = AccountType.Auth;
    private string _editorEmail = string.Empty;
    private int _editorKey;
    private string? _loadError;
    private bool _loading;
    private string _currentUserId = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _currentUserId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        }

        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            _accounts = await UserAccounts.ListAccountsAsync(CancellationToken.None);
        }
        catch (Exception exception)
        {
            _loadError = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void BeginEdit(ApplicationUser account)
    {
        _editing = account;
        _editorKey++;
    }

    private void ResetEditor()
    {
        _editing = null;
        _editorAccountType = AccountType.Auth;
        _editorEmail = string.Empty;
        _editorKey++;
    }

    private async Task OnSavedAsync(string userId)
    {
        Snackbar.Add(_editing is null ? "Added." : "Saved.", Severity.Success);
        ResetEditor();
        await RefreshAsync();
    }

    private async Task DeleteAsync(ApplicationUser account)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Delete account?",
            $"Delete {UserAccountService.DisplayName(account)}? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        var result = await UserAccounts.DeleteAsync(_currentUserId, account.RowKey, account.ETag, CancellationToken.None);
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? "Unable to delete that account.", Severity.Warning);
            return;
        }

        Snackbar.Add($"{UserAccountService.DisplayName(account)} deleted.", Severity.Success);
        if (_editing is not null && string.Equals(_editing.RowKey, account.RowKey, StringComparison.OrdinalIgnoreCase))
        {
            ResetEditor();
        }

        await RefreshAsync();
    }

    private static string BuildStrategyPreview(ApplicationUser account)
    {
        var strategyText = account.StrategyText;
        if (string.IsNullOrWhiteSpace(strategyText))
        {
            return string.Empty;
        }

        return strategyText.Length <= 100 ? strategyText : string.Concat(strategyText[..97], "...");
    }
}
