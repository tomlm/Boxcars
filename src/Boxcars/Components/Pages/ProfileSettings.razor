@page "/preferences"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using Boxcars.Auth
@using Boxcars.Data
@using Boxcars.Services
@attribute [Authorize]
@rendermode InteractiveServer
@inject UserDirectoryService UserDirectory
@inject NavigationManager Navigation

<PageTitle>Preferences - BoxCars</PageTitle>

@if (_loading)
{
    <MudStack Style="min-height: 12rem" Justify="Justify.Center" AlignItems="AlignItems.Center">
        <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="MudBlazor.Color.Primary" />
    </MudStack>
}
else if (_profile == null)
{
    <MudPaper Style="max-width: 37.5rem; margin: 2rem auto; text-align: center; padding: 2rem">
        <MudText Typo="Typo.h4">Unable to load profile</MudText>
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Style="margin-bottom: 1rem" Dense="true" Variant="Variant.Outlined" Severity="@messageSeverity">
                @message
            </MudAlert>
        }
        <MudStack Row="true" Justify="Justify.Center" Spacing="2" Style="margin-top: 1rem">
            <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="@LoadProfileAsync">Retry</MudButton>
            <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary" Href="/logout">Sign Out</MudButton>
        </MudStack>
    </MudPaper>
}
else
{
    <MudStack Style="max-width: 37.5rem; margin: 0 auto" Spacing="6">
        <MudText Typo="Typo.h3">Preferences</MudText>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Style="margin-bottom: 1rem" Dense="true" Variant="Variant.Outlined" Severity="@messageSeverity">
                @message
            </MudAlert>
        }

        <MudPaper Class="pa-6">
            <Boxcars.Components.Shared.ProfileEditor Account="_profile" StrategyRequired="true" OnSaved="OnSavedAsync">
                @if (!RequiredStrategy)
                {
                    <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Primary" OnClick="NavigateBack">
                        Back to Dashboard
                    </MudButton>
                }
            </Boxcars.Components.Shared.ProfileEditor>
        </MudPaper>
    </MudStack>
}

@code {
    private bool _loading = true;
    private string? message;
    private Severity messageSeverity = Severity.Info;
    private ApplicationUser? _profile;
    private string? currentUserId;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "requiredStrategy")]
    private bool RequiredStrategy { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authenticationState = await AuthenticationStateTask;
            currentUserId = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }

        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        _loading = true;
        message = null;

        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            _profile = null;
            message = "Error: Unable to determine the current user.";
            messageSeverity = Severity.Error;
            _loading = false;
            return;
        }

        // As stored, not the profile service's copy, which fills in a picture and strategy that saving would keep.
        _profile = await UserDirectory.GetUserAsync(currentUserId, CancellationToken.None);

        if (_profile == null)
        {
            message = "Error: Unable to load your preferences.";
            messageSeverity = Severity.Error;
            _loading = false;
            return;
        }

        if (RequiredStrategy && !PlayerProfileService.HasRequiredStrategyText(_profile.StrategyText))
        {
            message = "Set your strategy before continuing into the app.";
            messageSeverity = Severity.Warning;
        }

        _loading = false;
    }

    private async Task OnSavedAsync(string userId)
    {
        if (RequiredStrategy)
        {
            Navigation.NavigateTo(ResolvePostSaveTarget(), replace: true);
            return;
        }

        await LoadProfileAsync();
        message = "Your preferences have been updated.";
        messageSeverity = Severity.Success;
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo(ResolvePostSaveTarget());
    }

    private string ResolvePostSaveTarget()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl) && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative))
        {
            return ReturnUrl;
        }

        return "/dashboard";
    }
}